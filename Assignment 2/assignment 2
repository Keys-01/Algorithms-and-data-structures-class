def Dijkstra(graph, start):
    # Create a priority queue to store the vertices to be explored
    queue = []
    # Create a dictionary to store the shortest distance from the start vertex to each vertex
    distances = {vertex: float('infinity') for vertex in graph}
    # Set the distance from the start vertex to itself as 0
    distances[start] = 0
    # Add the start vertex to the priority queue
    queue.append((0, start))

    while queue:
        # Get the vertex with the smallest distance from the priority queue
        current_distance, current_vertex = min(queue)
        queue.remove((current_distance, current_vertex))

        # If the current distance is greater than the recorded distance, skip this vertex
        if current_distance > distances[current_vertex]:
            continue

        # Explore the neighbors of the current vertex
        for neighbor, weight in graph[current_vertex].items():
            distance = current_distance + weight

            # If a shorter path to the neighbor is found, update its distance and add it to the queue
            if distance < distances[neighbor]:
                distances[neighbor] = distance
                queue.append((distance, neighbor))

    return distances